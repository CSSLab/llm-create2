# Copy this setting into server/.env. The :cli command reuses your Firebase CLI login;
# the regular command requires the existing FIREBASE_* admin credentials.
# This is a server-only key. Never prefix it with VITE_ or commit its value.
OPENROUTER_API_KEY=

# Set an explicit label for the audience pilot when launching it.
AUDIENCE_PILOT_ID=audience-existing-poems-2026-09-08-v1
AUDIENCE_PILOT_VERSION=audience-existing-poems-2026-09-08-v1
